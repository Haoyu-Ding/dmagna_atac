Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%files
    environment.yml /opt/dmagna-atac/environment.yml
    bin/validate_samplesheet.py /opt/dmagna-atac/bin/validate_samplesheet.py
    bin/filter_paired_alignments.py /opt/dmagna-atac/bin/filter_paired_alignments.py
    bin/make_deeptools_regions.py /opt/dmagna-atac/bin/make_deeptools_regions.py

%post
    export MAMBA_ROOT_PREFIX=/opt/conda
    mkdir -p /opt/dmagna-atac/bin
    test -s /opt/dmagna-atac/environment.yml
    micromamba install --yes --name base --file /opt/dmagna-atac/environment.yml
    micromamba clean --all --yes
    chmod 0755 /opt/dmagna-atac/bin/validate_samplesheet.py
    chmod 0755 /opt/dmagna-atac/bin/filter_paired_alignments.py
    chmod 0755 /opt/dmagna-atac/bin/make_deeptools_regions.py
    rm -f /opt/dmagna-atac/environment.yml

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:/opt/dmagna-atac/bin:$PATH

%labels
    Author Haoyu Ding
    Project dmagna_atac
    Version 0.2.0

%test
    export PATH=/opt/conda/bin:/opt/dmagna-atac/bin:$PATH
    python --version
    fastqc --version
    cutadapt --version
    bwa-mem2 version
    samtools --version
    macs3 --version
    bamCoverage --version
    plotFingerprint --help >/dev/null
    multiqc --version
    ps --version
    python /opt/dmagna-atac/bin/validate_samplesheet.py --help
    python /opt/dmagna-atac/bin/filter_paired_alignments.py --help
    python /opt/dmagna-atac/bin/make_deeptools_regions.py --help

%runscript
    exec "$@"
