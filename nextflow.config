manifest {
    name = 'dmagna_atac'
    author = 'Haoyu Ding'
    description = 'Explicit-sample-sheet paired-end ATAC-seq pipeline for Daphnia magna'
    mainScript = 'main.nf'
    version = '0.1.0'
}

params {
    outdir = 'results'
    container = null
    min_length = 20
    adapter_r1 = 'AGATCGGAAGAGCACACGTCTGAACTCCAGTCA'
    adapter_r2 = 'AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT'
    extra_cutadapt = ''
    extra_bwa = ''
    extra_macs = ''
    slurm_partition = null
    slurm_account = null
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: VALIDATE_INPUT {
        cpus = 1
        memory = '1 GB'
        time = '30m'
    }
    withName: RAW_FASTQC {
        cpus = 2
        memory = '4 GB'
        time = '2h'
    }
    withName: TRIM_READS {
        cpus = 4
        memory = '8 GB'
        time = '4h'
    }
    withName: TRIMMED_FASTQC {
        cpus = 2
        memory = '4 GB'
        time = '2h'
    }
    withName: ALIGN_READS {
        cpus = 8
        memory = '16 GB'
        time = '12h'
    }
    withName: FILTER_BAM {
        cpus = 4
        memory = '64 GB'
        time = '12h'
        maxForks = 1
    }
    withName: CALL_PEAKS {
        cpus = 2
        memory = '8 GB'
        time = '4h'
    }
    withName: MULTIQC_SUMMARY {
        cpus = 2
        memory = '4 GB'
        time = '1h'
    }
    withName: SOFTWARE_VERSIONS {
        cpus = 1
        memory = '1 GB'
        time = '15m'
    }
}

profiles {
    vsc {
        process.executor = 'slurm'
        apptainer.enabled = true
        apptainer.autoMounts = true
        process.container = params.container
        process.queue = params.slurm_partition ?: 'batch'
        process.clusterOptions = "--clusters=wice"

        if (params.slurm_partition) {
            process.queue = params.slurm_partition
        }
        if (params.slurm_account) {
            process.clusterOptions = "--clusters=wice --account=${params.slurm_account}"
        }
    }
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
    fields = 'task_id,hash,process,name,tag,status,exit,submit, start, complete, duration, realtime, cpus,memory,attempt'
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_dag.html"
    overwrite = true
}
